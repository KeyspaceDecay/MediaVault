# Хост и порт сервера
HOST=0.0.0.0
PORT=8666

# Пароль для входа в веб-интерфейс.
# Если не задать — будет сгенерирован автоматически при первом запуске
# и записан сюда же (смотрите вывод в консоли).
MEDIAVAULT_PASSWORD=changeme

# Время жизни сессии, секунды (по умолчанию 7 дней)
# SESSION_TTL=604800
