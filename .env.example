# Хост и порт сервера.
# Yggdrasil: укажите ваш ygg-адрес (yggdrasilctl getSelf), например:
#   HOST=202:2542:c440:ce0d:1ca2:998d:b1e0:468f
# 0.0.0.0 — все интерфейсы.
HOST=202:2542:c440:ce0d:1ca2:998d:b1e0:468f
PORT=8666

# Пароль для входа в веб-интерфейс.
# Используется только при первом запуске (или после сброса data/auth.json):
# затем пароль хранится как PBKDF2-хэш в data/auth.json и меняется в веб-интерфейсе.
# Если не задать — будет сгенерирован автоматически и показан в консоли.
MEDIAVAULT_PASSWORD=changeme

# Время жизни сессии, секунды (по умолчанию 7 дней)
# SESSION_TTL=604800
